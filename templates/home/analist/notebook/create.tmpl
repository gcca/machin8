{{define "home/analist/notebook/create.tmpl"}}
<dialog id="create-notebook-modal" class="modal modal-open">
  <div class="modal-box">
    <h3 class="text-lg font-semibold">Create notebook</h3>
    <p class="mt-2 text-sm opacity-70">Create a new notebook for the current user.</p>

    {{if .Error}}
    <div class="alert alert-error mt-4">
      <span>{{.Error}}</span>
    </div>
    {{end}}

    <form
      class="mt-6 space-y-4"
      hx-post="/machin8/home/analist/notebook/create"
    >
      <label class="form-control">
        <div class="label">
          <span class="label-text">Title</span>
        </div>
        <input
          type="text"
          name="title"
          class="input input-bordered w-full"
          placeholder="Optional notebook title"
        >
      </label>

      <div class="flex items-center justify-end gap-3">
        <button
          type="button"
          class="btn btn-ghost"
          hx-get="/machin8/home/analist/notebook/list"
          hx-target="#home-content"
          hx-swap="innerHTML"
          hx-on:click="document.getElementById('modal-root').innerHTML = ''"
        >
          Cancel
        </button>
        <button type="submit" class="btn btn-primary">
          Create notebook
        </button>
      </div>
    </form>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button hx-on:click="document.getElementById('modal-root').innerHTML = ''">close</button>
  </form>
</dialog>
{{end}}
