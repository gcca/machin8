{{define "home/analist/index.tmpl"}}
<!doctype html>
<html lang="en" data-theme="lemonade">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>machin8</title>
  <link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css" />
  <link href="https://cdn.jsdelivr.net/npm/daisyui@5/themes.css" rel="stylesheet" type="text/css" />
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.10/dist/htmx.min.js" integrity="sha384-H5SrcfygHmAuTDZphMHqBJLc3FhssKjG7w/CeCpFReSfwBWDTKpkzPP8c+cLsK+V" crossorigin="anonymous"></script>
  <script>
    function setHomeNavActive(path) {
      document.querySelectorAll("[data-home-nav-item]").forEach(function (el) {
        el.removeAttribute("aria-current");
        const mark = el.querySelector("[data-home-nav-mark]");
        if (mark) {
          mark.classList.add("hidden");
        }
      });
      const next = document.querySelector('[data-home-nav="' + path + '"]');
      if (next) {
        const item = next.closest("[data-home-nav-item]");
        if (item) {
          item.setAttribute("aria-current", "page");
          const mark = item.querySelector("[data-home-nav-mark]");
          if (mark) {
            mark.classList.remove("hidden");
          }
        }
      }
    }

    document.addEventListener("DOMContentLoaded", function () {
      {{if or (eq .Tab "home") (eq .Tab "notebook")}}
      setHomeNavActive("/machin8/home/analist/{{.Tab}}");
      {{end}}
    });
  </script>
</head>
<body class="min-h-screen bg-base-200 text-base-content">
  <div class="drawer lg:drawer-open">
    <input id="home-drawer" type="checkbox" class="drawer-toggle">
    <div class="drawer-content flex min-h-screen flex-col">
      <div class="navbar border-b border-base-300 bg-base-100 lg:hidden">
        <div class="flex-none">
          <label for="home-drawer" class="btn btn-square btn-ghost" aria-label="open sidebar">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </label>
        </div>
        <div class="flex-1 px-2 text-lg font-semibold">machin8</div>
      </div>

      <main
        id="home-content"
        class="flex-1 p-4 sm:p-6 lg:p-8"
        {{if or (eq .Tab "home") (eq .Tab "notebook")}}
        hx-get="/machin8/home/analist/{{.Tab}}"
        hx-trigger="load"
        hx-swap="innerHTML"
        {{end}}
      >
        {{if eq .Tab "blank"}}
        <div class="mx-auto max-w-5xl"></div>
        {{end}}
      </main>
      <div id="modal-root"></div>
    </div>

    <div class="drawer-side">
      <label for="home-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
      <aside class="flex min-h-full w-80 flex-col border-r border-base-300 bg-base-100 p-4 text-base-content">
        <div class="mb-6">
          <div class="badge badge-secondary border-0">analist</div>
          <h2 class="mt-3 text-2xl font-semibold">Workspace</h2>
          <p class="mt-1 text-sm opacity-70">Pick Home or Notebooks.</p>
        </div>

        <ul class="menu w-full rounded-box p-2">
          <li data-home-nav-item {{if eq .Tab "home"}}aria-current="page"{{end}}>
            <a
              class="flex items-center justify-between gap-3 font-medium"
              data-home-nav="/machin8/home/analist/home"
              onclick="setHomeNavActive('/machin8/home/analist/home')"
              hx-get="/machin8/home/analist/home"
              hx-target="#home-content"
              hx-swap="innerHTML"
              hx-push-url="/machin8/home/analist?t=home"
              href="/machin8/home/analist/home"
            >
              <span class="flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 opacity-80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 10.5 12 3l9 7.5" />
                  <path d="M5 9.5V21h14V9.5" />
                  <path d="M9 21v-6h6v6" />
                </svg>
                Home
              </span>
              <span data-home-nav-mark class="{{if eq .Tab "home"}}{{else}}hidden{{end}} h-2.5 w-2.5 rounded-full bg-primary" aria-hidden="true"></span>
            </a>
          </li>
          <li data-home-nav-item {{if eq .Tab "notebook"}}aria-current="page"{{end}}>
            <a
              class="flex items-center justify-between gap-3 font-medium"
              data-home-nav="/machin8/home/analist/notebook"
              onclick="setHomeNavActive('/machin8/home/analist/notebook')"
              hx-get="/machin8/home/analist/notebook"
              hx-target="#home-content"
              hx-swap="innerHTML"
              hx-push-url="/machin8/home/analist?t=notebook"
              href="/machin8/home/analist/notebook"
            >
              <span class="flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 opacity-80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 3h8l4 4v14H7z" />
                  <path d="M15 3v4h4" />
                  <path d="M9 10h6" />
                  <path d="M9 14h6" />
                </svg>
                Notebooks
              </span>
              <span data-home-nav-mark class="{{if eq .Tab "notebook"}}{{else}}hidden{{end}} h-2.5 w-2.5 rounded-full bg-primary" aria-hidden="true"></span>
            </a>
          </li>
        </ul>

        <div class="mt-auto pt-6">
          <div class="dropdown dropdown-top dropdown-end w-full">
            <div tabindex="0" role="button" class="btn btn-ghost w-full justify-start gap-3 px-3">
              <div class="avatar">
                <div class="flex h-9 w-9 items-center justify-center rounded-full bg-base-200">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 opacity-80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3 3" />
                  </svg>
                </div>
              </div>
              <div class="min-w-0 flex-1 text-left">
                <div class="truncate text-sm font-medium">Profile</div>
                <div class="truncate text-xs opacity-70">Analist</div>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 opacity-60" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.294l3.71-4.064a.75.75 0 1 1 1.1 1.02l-4.24 4.645a.75.75 0 0 1-1.1 0L5.21 8.25a.75.75 0 0 1 .02-1.04Z" clip-rule="evenodd"/>
              </svg>
            </div>
            <ul tabindex="-1" class="dropdown-content menu rounded-box bg-base-100 p-2 shadow">
              <li><a>Sign Out</a></li>
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </div>
</body>
</html>
{{end}}
